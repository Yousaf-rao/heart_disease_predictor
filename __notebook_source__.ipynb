import numpy as np
from sklearn.impute import KNNImputer
import pandas as pd

# Step 1: Replace invalid 0 values with NaN (Not a Number)
# In medical data, a cholesterol level of 0 is biologically impossible.
# We replace 0 with np.nan so the imputer knows these are "missing" values.
heart_df['Cholesterol'].replace(0, np.nan, inplace=True)

# Step 2: Initialize the KNNImputer
# Why KNN? K-Nearest Neighbors looks at 'n' similar patients (neighbors) 
# and estimates the missing cholesterol based on their data.
imputer = KNNImputer(n_neighbors=3)

# Step 3: Perform the Imputation
# fit_transform calculates the missing values and fills them in.
after_impute = imputer.fit_transform(heart_df)

# Step 4: Convert the result back into a clean DataFrame
heart_df = pd.DataFrame(after_impute, columns=heart_df.columns)

# Step 5: Verify the results
heart_df


heart_df['RestingBP'][heart_df['RestingBP'] == 0]


from sklearn.impute import KNNImputer

# Step 1: Replace invalid 0 values with NaN
# Just like Cholesterol, Resting Blood Pressure cannot be 0 for a living patient.
# We replace 0 with 'np.nan' so the imputer can identify it as a missing value.
heart_df['RestingBP'].replace(0, np.nan, inplace=True)

# Step 2: Initialize the KNNImputer
# We use 3 neighbors (n_neighbors=3) to estimate the missing Blood Pressure 
# based on the 3 most similar patient profiles in the dataset.
imputer = KNNImputer(n_neighbors=3)

# Step 3: Apply the imputation
# The fit_transform function calculates the missing values and fills them.
after_impute = imputer.fit_transform(heart_df)

# Step 4: Reconstruct the DataFrame
# Since the imputer returns a numpy array, we convert it back into a pandas DataFrame.
heart_df = pd.DataFrame(after_impute, columns=heart_df.columns)




# Step 5: Verification
# unique() shows all distinct values to ensure '0' is gone.
# isnull().sum() confirms there are no remaining missing values in the column.
heart_df['RestingBP'].unique()
heart_df['RestingBP'].isnull().sum()


# 1. Get a list of all column names in the heart_df DataFrame
withoutOldPeak = heart_df.columns

# 2. Remove the specific column 'Oldpeak' from this list
# We do this because 'Oldpeak' contains decimal values (float) and cannot be converted to an integer.
withoutOldPeak = withoutOldPeak.drop('Oldpeak')

# 3. Convert the data type of the remaining columns to 32-bit integers
# This changes columns like 'Age', 'RestingBP', and 'Cholesterol' from float/object to int.
heart_df[withoutOldPeak] = heart_df[withoutOldPeak].astype('int32')


